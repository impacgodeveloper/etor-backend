# ─── Direct PostgreSQL connection (required) ───────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_db_password@your-project-ref.supabase.co:5432/postgres
PORT=5000
NODE_ENV=development

# Supabase credentials (from Settings → API in Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=paste_your_service_role_key_here
# JWT secret for backend-issued tokens (generate any long random string)
JWT_SECRET=any_long_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# External farm API (your Flutter cows screen uses this)
FARM_API_URL=https://dfms.impacgo.com/api

# ── Outbound email (signup + trial-expiry notifications) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=info@impacgo.com

# ── DFMS Integration ─────────────────────────────────────────────────────>
# Fill these in when DFMS goes live. Leave blank to disable (graceful fallb>
# DFMS_API_URL  : Base URL of DFMS  (default: https://dfms.impacgo.com)
# DFMS_ADMIN_ID : The super-admin ID used to fetch all cows
# DFMS_ADMIN_TOKEN : The bearer token for DFMS super-admin API
DFMS_API_URL=https://dfms.impacgo.com
DFMS_ADMIN_ID=
DFMS_ADMIN_TOKEN=

