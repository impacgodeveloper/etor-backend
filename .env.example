# ─── Direct PostgreSQL connection (required) ───────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.plgqdeeroomdwdicedhu.supabase.co:5432/postgres

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=*

# ─── Supabase Storage (optional — only needed for file uploads) ──────────────
# If omitted, document/avatar upload endpoints will not function.
SUPABASE_URL=https://plgqdeeroomdwdicedhu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── External farm API (optional) ───────────────────────────────────────────
DFMS_API_URL=https://dfms.impacgo.com
DFMS_ADMIN_TOKEN=
